<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kalkulator Beton v7.0 Pro</title>
    <!-- Tailwind CSS -->
    <script src="https://tailwindcss.com"></script>
    <!-- Pustaka jsPDF & AutoTable -->
    <script src="https://cloudflare.com"></script>
    <script src="https://cloudflare.com"></script>
    <!-- Menghubungkan file CSS eksternal -->
    <link rel="stylesheet" href="style.css">
</head>
<body class="bg-slate-100 text-slate-800 min-h-screen pb-12">

    <!-- Header Aplikasi -->
    <header class="bg-slate-900 text-white shadow-lg">
        <div class="max-w-6xl mx-auto px-4 py-5 flex flex-col sm:flex-row justify-between items-center gap-4">
            <div>
                <div class="flex items-center gap-2">
                    <span class="badge-pro">v7.0 PRO</span>
                    <h1 class="text-xl sm:text-2xl font-bold tracking-tight">Kalkulator Beton & RAB</h1>
                </div>
                <p class="text-slate-400 text-xs mt-1">Estimasi Volume, Mix Design SNI, & Laporan PDF Instan</p>
            </div>
            <button onclick="exportToPDF()" class="btn-pdf">
                <svg xmlns="http://w3.org" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                Unduh Laporan PDF
            </button>
        </div>
    </header>

    <!-- Konten Utama -->
    <main class="max-w-6xl mx-auto px-4 mt-6 grid grid-cols-1 lg:grid-cols-12 gap-6">
        
        <!-- Panel Kiri: Input Parameter -->
        <div class="lg:col-span-7 space-y-6">
            
            <!-- 1. Data Proyek -->
            <div class="card-panel">
                <h2 class="section-title">1. Informasi Proyek</h2>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="input-label">Nama Proyek</label>
                        <input type="text" id="projectName" value="Pembangunan Rumah Tinggal" class="input-field">
                    </div>
                    <div>
                        <label class="input-label">Lokasi / Klien</label>
                        <input type="text" id="projectLocation" value="Semarang, Jawa Tengah" class="input-field">
                    </div>
                </div>
            </div>

            <!-- 2. Dimensi & Elemen Struktur -->
            <div class="card-panel">
                <h2 class="section-title">2. Dimensi & Elemen Struktur</h2>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
                    <div>
                        <label class="input-label">Jenis Elemen</label>
                        <select id="elementType" onchange="updateFormFields()" class="input-field bg-white">
                            <option value="slab">Pelat Lantai / Dak Beton</option>
                            <option value="beam">Balok / Sloof / Kolom Persegi</option>
                            <option value="column_round">Kolom Bulat (Silinder)</option>
                        </select>
                    </div>
                    <div>
                        <label class="input-label">Jumlah Unit / Titik</label>
                        <input type="number" id="unitCount" value="1" min="1" oninput="calculateAll()" class="input-field">
                    </div>
                </div>

                <!-- Input Dinamis Dimensi -->
                <div id="dimensionInputs" class="grid grid-cols-1 sm:grid-cols-3 gap-4"></div>
            </div>

            <!-- 3. Mutu Beton & Harga Satuan -->
            <div class="card-panel">
                <h2 class="section-title">3. Mutu Beton (SNI) & Harga Material</h2>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-4">
                    <div>
                        <label class="input-label">Mutu Beton</label>
                        <select id="concreteGrade" onchange="calculateAll()" class="input-field bg-white">
                            <option value="K175">K-175 (Lantai Kerja / Ringan)</option>
                            <option value="K225" selected>K-225 (Struktur Rumah 1-2 Lt)</option>
                            <option value="K250">K-250 (Struktur Menengah)</option>
                            <option value="K300">K-300 (Struktur Berat / Dak)</option>
                        </select>
                    </div>
                    <div>
                        <label class="input-label">Berat Kemasan Semen</label>
                        <select id="cementBagWeight" onchange="calculateAll()" class="input-field bg-white">
                            <option value="40">40 Kg / Zak</option>
                            <option value="50" selected>50 Kg / Zak</option>
                        </select>
                    </div>
                    <div>
                        <label class="input-label">Faktor Susut / Waste (%)</label>
                        <input type="number" id="wasteFactor" value="5" min="0" max="30" oninput="calculateAll()" class="input-field">
                    </div>
                </div>

                <div class="border-t border-slate-100 pt-4 grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div>
                        <label class="input-label">Harga Semen (Rp / Zak)</label>
                        <input type="number" id="priceCement" value="65000" oninput="calculateAll()" class="input-field">
                    </div>
                    <div>
                        <label class="input-label">Harga Pasir (Rp / m³)</label>
                        <input type="number" id="priceSand" value="320000" oninput="calculateAll()" class="input-field">
                    </div>
                    <div>
                        <label class="input-label">Harga Split (Rp / m³)</label>
                        <input type="number" id="priceGravel" value="350000" oninput="calculateAll()" class="input-field">
                    </div>
                </div>
            </div>

        </div>

        <!-- Panel Kanan: Hasil Perhitungan -->
        <div class="lg:col-span-5 space-y-6">
            
            <!-- Kartu Ringkasan Volume -->
            <div class="bg-slate-900 text-white p-6 rounded-xl shadow-md">
                <p class="text-slate-400 text-xs uppercase font-semibold tracking-wider">Total Volume Beton (Termasuk Waste)</p>
                <div class="flex items-baseline gap-2 mt-1">
                    <span id="resTotalVolume" class="text-4xl font-extrabold text-amber-400">0.00</span>
                    <span class="text-lg text-slate-300 font-medium">m³</span>
                </div>
                <p id="resNetVolume" class="text-xs text-slate-400 mt-1">Volume Bersih: 0.00 m³</p>
            </div>

            <!-- Rincian Kebutuhan Material -->
            <div class="card-panel">
                <h2 class="section-title">Kebutuhan Material & Biaya</h2>
                
                <div class="space-y-3 text-sm">
                    <div class="material-row">
                        <div>
                            <p class="font-bold text-slate-800">Semen Portland</p>
                            <p id="resCementKg" class="text-xs text-slate-500">0 kg</p>
                        </div>
                        <div class="text-right">
                            <p id="resCementBags" class="font-bold text-slate-900">0 Zak</p>
                            <p id="resCostCement" class="text-xs font-semibold text-emerald-600">Rp 0</p>
                        </div>
                    </div>

                    <div class="material-row">
                        <div>
                            <p class="font-bold text-slate-800">Pasir Beton</p>
                            <p id="resSandKg" class="text-xs text-slate-500">0 kg (BJ 1400 kg/m³)</p>
                        </div>
                        <div class="text-right">
                            <p id="resSandM3" class="font-bold text-slate-900">0.00 m³</p>
                            <p id="resCostSand" class="text-xs font-semibold text-emerald-600">Rp 0</p>
                        </div>
                    </div>

                    <div class="material-row">
                        <div>
                            <p class="font-bold text-slate-800">Kerikil / Batu Split</p>
                            <p id="resGravelKg" class="text-xs text-slate-500">0 kg (BJ 1350 kg/m³)</p>
                        </div>
                        <div class="text-right">
                            <p id="resGravelM3" class="font-bold text-slate-900">0.00 m³</p>
                            <p id="resCostGravel" class="text-xs font-semibold text-emerald-600">Rp 0</p>
                        </div>
                    </div>

                    <div class="material-row">
                        <div>
                            <p class="font-bold text-slate-800">Air Kerja</p>
                            <p class="text-xs text-slate-500">Estimasi Mix SNI</p>
                        </div>
                        <div class="text-right">
                            <p id="resWaterLiter" class="font-bold text-slate-900">0 Liter</p>
                            <p class="text-xs text-slate-400">-</p>
                        </div>
                    </div>
                </div>

                <div class="mt-5 pt-4 border-t-2 border-dashed border-slate-200 flex justify-between items-center">
                    <span class="font-bold text-slate-700">Total Estimasi RAB</span>
